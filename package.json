{
  "name": "concept-slate-piston",
  "version": "1.0.0",
  "private": true,
  "description": "An OFF/SHIFT concept \u2014 fictional demonstration. Slate Piston, an independent automotive workshop.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
